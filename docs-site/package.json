{
  "name": "scribe-documentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "generate": "python ../docgen/gen.py",
    "dev": "node scripts/dev.mjs",
    "prebuild": "python ../docgen/gen.py",
    "build": "astro build && python ../docgen/check_site.py",
    "preview": "astro preview --host 127.0.0.1",
    "check": "python ../docgen/check_starlight.py && node --test ../docgen/starlight-headings.test.mjs && node ../docgen/playground/check.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "astro": "7.3.3"
  }
}
